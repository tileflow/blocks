{
  "name": "@tileflow/elements",
  "version": "0.1.0-alpha.0",
  "description": "Tileflow map components as custom elements, for any web page.",
  "license": "MIT",
  "type": "module",
  "sideEffects": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tileflow/blocks.git",
    "directory": "elements"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && node scripts/build.mjs && tsc -p tsconfig.build.json",
    "dev": "vite",
    "demo:build": "vite build",
    "demo:preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tileflow/dom": "file:../.sdk-packs/tileflow-dom-0.0.0-development.tgz",
    "@tileflow/interactions": "file:../.sdk-packs/tileflow-interactions-0.0.0-development.tgz"
  },
  "peerDependencies": {
    "maplibre-gl": ">=6.4.1 <7"
  },
  "devDependencies": {
    "@tileflow/core": "file:../.sdk-packs/tileflow-core-0.0.0-development.tgz",
    "@tileflow/maps": "0.1.0-alpha.20",
    "@tileflow/vite": "0.1.0-alpha.26",
    "esbuild": "0.28.1",
    "maplibre-gl": "6.16.0",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
