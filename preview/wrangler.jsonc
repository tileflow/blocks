// Review preview of the gallery: the static export from `pnpm preview:build`, served only at
// blocks-preview.tileflow.dev, which Cloudflare Access limits to the team. No workers.dev or
// preview URLs, so there is no unprotected address.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tileflow-blocks-preview",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "blocks-preview.tileflow.dev/*", "zone_name": "tileflow.dev" }],
  "assets": {
    "directory": "../out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
